# WorkForceIQ Environment Configuration

# Database: SQLite is default for zero-setup local development
DATABASE_URL=sqlite:///./workforceiq.db

# For PostgreSQL production / configured environments:
# DATABASE_URL=postgresql://user:password@localhost:5432/workforceiq

# Frontend API URL (defaults to http://127.0.0.1:8000/api if unset)
VITE_API_URL=http://127.0.0.1:8000/api
